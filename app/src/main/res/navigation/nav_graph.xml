<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/menuFragment">

    <fragment
        android:id="@+id/menuFragment"
        android:name="com.example.utsmobileapp.ui.menu.MenuFragment"
        android:label="@string/title_menu">
        <action
            android:id="@+id/action_menu_to_detail"
            app:destination="@id/detailProductFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailProductFragment"
        android:name="com.example.utsmobileapp.ui.menu.DetailProductFragment"
        android:label="@string/title_detail" />

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.example.utsmobileapp.ui.about.AboutFragment"
        android:label="@string/title_about" />

</navigation>
